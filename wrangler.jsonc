{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumen-rack",
  "compatibility_date": "2026-09-01",
  // Static site: Cloudflare serves the Vite build output directly, no Worker script needed.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
